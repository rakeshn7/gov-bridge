# ─── SIH26129 Government Interoperability Framework ──────────────────────────
# Copy this file to .env and fill in values before running docker-compose up
# Never commit .env to version control

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=gil
POSTGRES_PASSWORD=gilpassword
POSTGRES_DB=gildb
DATABASE_URL=postgresql+asyncpg://gil:gilpassword@postgres:5432/gildb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
# Citizen-facing JWT (OAuth2 simulation)
JWT_SECRET=changeme-supersecret-jwt-key-minimum-32-chars
JWT_ISSUER=gil-auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Service-to-service JWT (GIL → mock systems)
SERVICE_JWT_SECRET=service-secret-key-dev-min-32-chars

# OAuth2 client credentials (used by frontend to obtain citizen tokens)
OAUTH_CLIENT_ID=citizen-app
OAUTH_CLIENT_SECRET=citizen-secret

# ─── Mock System URLs (internal Docker network) ───────────────────────────────
EMPLOYMENT_API_URL=http://mock-employment:8001
SKILL_API_URL=http://mock-skill:8002

# ─── Retry / Failure Handling ─────────────────────────────────────────────────
RETRY_INITIAL_DELAY=2         # seconds before first retry
RETRY_BACKOFF_FACTOR=2        # exponential multiplier per attempt
RETRY_MAX_ATTEMPTS=3          # retries exhausted → manual_review_queue
TIMEOUT_PER_SYSTEM=10         # per-adapter call timeout in seconds

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Used by Next.js at runtime (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_GIL_API_URL=http://localhost:8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
